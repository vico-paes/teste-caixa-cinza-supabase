{
  "info": {
    "_postman_id": "0d6d6bff-fb90-447a-b359-ecb0329330c9",
    "name": "Caixa Cinza - Autenticacao Supabase",
    "description": "Testes caixa cinza do endpoint /auth/v1/token?grant_type=password do Supabase. Aluno: Vinicius Paes Lima - RA 2520215",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CT01 - Login valido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "",
              "pm.test(\"Status HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Retorna access_token\", function () {",
              "    pm.expect(json.access_token).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "pm.test(\"token_type = bearer\", function () {",
              "    pm.expect(json.token_type).to.eql(\"bearer\");",
              "});",
              "",
              "pm.test(\"Usuario retornado e o mesmo do login\", function () {",
              "    pm.expect(json.user.email).to.eql(pm.environment.get(\"email\"));",
              "});",
              "",
              "pm.test(\"Tempo de resposta menor que 2s\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "CT02 - Senha incorreta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "",
              "pm.test(\"Status HTTP 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Nao retorna access_token\", function () {",
              "    pm.expect(json.access_token).to.be.undefined;",
              "});",
              "",
              "pm.test(\"Retorna mensagem de erro\", function () {",
              "    pm.expect(json.msg || json.error_description).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "pm.test(\"error_code = invalid_credentials\", function () {",
              "    pm.expect(json.error_code).to.eql(\"invalid_credentials\");",
              "});"
            ]
          }
        }
      ],
